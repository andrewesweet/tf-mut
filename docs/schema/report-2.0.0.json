{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrewesweet/tf-mut/docs/schema/report-2.0.0.json",
  "title": "tf-mut report",
  "description": "The machine-readable result of a tf-mut run or preview. The version in schema_version changes whenever a consumer could break: removed fields, renamed fields, or changed semantics of an existing field. Version 2 adds the fingerprint oracle's states and diagnoses, per-run phases, suppressions and per-operator error counts.",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "module",
    "terraform_version",
    "test_directory",
    "baseline",
    "mutants",
    "findings",
    "metrics",
    "operator_errors",
    "suppressions",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "command": {
      "type": "string",
      "enum": [
        "run",
        "preview"
      ]
    },
    "module": {
      "type": "string",
      "description": "Absolute directory of the module under test."
    },
    "terraform_version": {
      "type": "string"
    },
    "test_directory": {
      "type": "string",
      "description": "Test directory, relative to the module."
    },
    "baseline": {
      "type": "object",
      "required": [
        "runs",
        "assertions",
        "duration_ms",
        "fingerprint",
        "volatile_components"
      ],
      "properties": {
        "runs": {
          "type": "integer"
        },
        "assertions": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        },
        "fingerprint": {
          "type": "string",
          "description": "Composed masked fingerprint of the unmutated suite."
        },
        "volatile_components": {
          "type": "array",
          "description": "Canonical payload paths the volatile mask removes.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mutants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mutant"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "mutation_score",
        "assertion_score",
        "reachability",
        "incomplete",
        "counts",
        "diagnoses",
        "scored"
      ],
      "properties": {
        "mutation_score": {
          "type": "number"
        },
        "assertion_score": {
          "type": "number"
        },
        "reachability": {
          "type": "number"
        },
        "incomplete": {
          "type": "boolean",
          "description": "True when a timeout made the score untrustworthy."
        },
        "counts": {
          "type": "object",
          "description": "Number of mutants in each state.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "diagnoses": {
          "type": "object",
          "description": "Number of survivors carrying each diagnosis.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "scored": {
          "type": "integer",
          "description": "Killed + KilledByError + Survived + StructurallyUnassertable + NoCoverage + Timeout."
        }
      }
    },
    "operator_errors": {
      "type": "array",
      "description": "Per-operator generation quality, so that the selective-validation question can be answered from data.",
      "items": {
        "type": "object",
        "required": [
          "operator",
          "generated",
          "invalid",
          "killed_by_error",
          "error_rate"
        ],
        "properties": {
          "operator": {
            "$ref": "#/$defs/operator"
          },
          "generated": {
            "type": "integer"
          },
          "invalid": {
            "type": "integer"
          },
          "killed_by_error": {
            "type": "integer"
          },
          "error_rate": {
            "type": "number"
          }
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suppression"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "description": "Mutants that produced no trustworthy verdict. Never a survivor.",
      "items": {
        "type": "object",
        "required": [
          "mutant_id",
          "site",
          "message"
        ],
        "properties": {
          "mutant_id": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        }
      }
    },
    "range": {
      "type": "object",
      "required": [
        "file",
        "start",
        "end"
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "Path relative to the local-module closure root."
        },
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "operator": {
      "type": "string",
      "enum": [
        "ARITH-SWAP",
        "BOOL-AND-OR",
        "BOOL-LITERAL-FLIP",
        "BOOL-NEGATE-INSERT",
        "BOOL-NEGATE-REMOVE",
        "BOOL-OR-AND",
        "CHECK-NEGATE",
        "CHECK-REMOVE",
        "CMP-BOUNDARY",
        "CMP-EQ-NE",
        "CMP-INVERT",
        "COLL-DROP-ENTRY",
        "COLL-DROP-FIRST",
        "COLL-DROP-LAST",
        "COLL-EMPTY",
        "COLL-REVERSE",
        "COND-FALSE",
        "COND-NEGATE",
        "COND-SWAP",
        "COND-TRUE",
        "COUNT-OFF-BY-ONE",
        "COUNT-ONE",
        "COUNT-ZERO",
        "DEPENDS-DROP",
        "DYNAMIC-ZERO",
        "EXT-ATTR-DELETE",
        "EXT-BODY-BLANK",
        "EXT-LOCAL-NULL",
        "EXT-MODULE-INPUT-DELETE",
        "EXT-OUTPUT-NULL",
        "EXT-RESOURCE-DELETE",
        "FN-ARG-REORDER",
        "FN-CAN-TRUE",
        "FN-DROP-DEFAULT",
        "FN-DROP-EXPANSION",
        "FN-DROP-WRAPPER",
        "FN-JOIN-SEP",
        "FN-SWAP",
        "FN-TRY-FIRST",
        "FOR-DROP-GROUPING",
        "FOR-DROP-IF",
        "FOR-NEGATE-IF",
        "FOR-SWAP-KV",
        "FOREACH-EMPTY",
        "FOREACH-TO-COUNT",
        "HEREDOC-INDENT-FLIP",
        "IDX-SHIFT",
        "NULL-INJECT",
        "NUM-NEGATE",
        "NUM-OFF-BY-ONE",
        "NUM-ZERO",
        "OUT-SENSITIVE-FLIP",
        "PRE-POST-NEGATE",
        "PRE-POST-REMOVE",
        "PROVIDER-ALIAS-SWAP",
        "SPLAT-FIRST",
        "STR-CASE",
        "STR-EMPTY",
        "TPL-DROP-INTERP",
        "TPL-IF-COLLAPSE",
        "TPL-STRIP-FLIP",
        "VAR-DEFAULT-CHANGE",
        "VAR-DEFAULT-NULL",
        "VAR-DEFAULT-REMOVE",
        "VAR-NULLABLE-FLIP",
        "VAR-OPTIONAL-DEFAULT-DROP",
        "VAR-SENSITIVE-FLIP",
        "VAR-VALIDATION-NEGATE",
        "VAR-VALIDATION-REMOVE",
        "VAR-VALIDATION-WEAKEN"
      ]
    },
    "diagnosis": {
      "type": "string",
      "description": "Set only for Survived. Exactly one, assigned by the normative precedence: indeterminate-unknown-values, indeterminate-volatility, mock-masked, weak-assertion, no-assertion, unasserted.",
      "enum": [
        "indeterminate-unknown-values",
        "indeterminate-volatility",
        "mock-masked",
        "weak-assertion",
        "no-assertion",
        "unasserted"
      ]
    },
    "change": {
      "type": "object",
      "required": [
        "run",
        "path",
        "baseline",
        "mutant"
      ],
      "properties": {
        "run": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Canonical payload path."
        },
        "address": {
          "type": "string",
          "description": "Terraform address the path names, when it names one."
        },
        "baseline": {
          "type": "string",
          "description": "Canonical rendering; empty means the path was absent."
        },
        "mutant": {
          "type": "string"
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "message",
        "fix",
        "evidence"
      ],
      "properties": {
        "diagnosis": {
          "$ref": "#/$defs/diagnosis"
        },
        "message": {
          "type": "string"
        },
        "fix": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "delta": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/change"
              }
            },
            "unknown_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "volatile_components": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unstable_attributes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assertion": {
              "type": "string"
            },
            "closure_verdict": {
              "type": "string"
            },
            "defeated_by": {
              "type": "string"
            },
            "mock_resource": {
              "type": "string"
            }
          }
        }
      }
    },
    "suppression": {
      "type": "object",
      "required": [
        "kind",
        "accepted"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "comment",
            "config-operator",
            "config-path",
            "config-resource"
          ]
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean",
          "description": "A directive without a reason does not suppress: the finding stands and the directive is reported here as rejected."
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "mutants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejection": {
          "type": "string"
        }
      }
    },
    "mutant": {
      "type": "object",
      "required": [
        "id",
        "operator",
        "tier",
        "module",
        "site",
        "range",
        "diff",
        "state",
        "runs",
        "executed_runs",
        "validated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Hash of operator, closure-relative path, site address, replaced content and replacement. Stable under line moves and unrelated edits; broken by renaming the file."
        },
        "operator": {
          "$ref": "#/$defs/operator"
        },
        "tier": {
          "type": "string",
          "enum": [
            "smoke",
            "standard",
            "deep"
          ]
        },
        "module": {
          "type": "string",
          "description": "Module directory relative to the closure root."
        },
        "site": {
          "type": "string",
          "description": "Semantic address of the mutation site."
        },
        "resource": {
          "type": "string",
          "description": "Managed resource address the site belongs to, when it has one."
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "diff": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "Invalid",
            "Killed",
            "KilledByError",
            "Timeout",
            "Survived",
            "StructurallyUnassertable",
            "Unobservable",
            "NoCoverage",
            "Ignored",
            "Pending"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "runs": {
          "type": "array",
          "description": "Per-run outcomes, recorded orthogonally to the aggregate state. Phase two appears only for phase-one survivors.",
          "items": {
            "type": "object",
            "required": [
              "file",
              "run",
              "phase",
              "status"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "run": {
                "type": "string"
              },
              "phase": {
                "type": "integer",
                "enum": [
                  1,
                  2
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "error",
                  "skip"
                ]
              }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "severity",
              "summary",
              "detail"
            ],
            "properties": {
              "severity": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "range": {
                "$ref": "#/$defs/range"
              },
              "test_file": {
                "type": "string"
              },
              "test_run": {
                "type": "string"
              }
            }
          }
        },
        "executed_runs": {
          "type": "integer"
        },
        "validated": {
          "type": "boolean",
          "description": "Whether lazy validation ran, which happens only after a run-level error."
        },
        "suppression": {
          "$ref": "#/$defs/suppression"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "address",
        "module",
        "range",
        "message",
        "mutants"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "pseudo-tested"
          ]
        },
        "address": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "message": {
          "type": "string"
        },
        "mutants": {
          "type": "array",
          "description": "Identifiers of the mutants supporting the finding.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
