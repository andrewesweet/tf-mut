{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrewesweet/tf-mut/docs/schema/report-2.3.0.json",
  "title": "tf-mut report",
  "description": "The machine-readable result of a tf-mut run or preview. The version in schema_version changes whenever a consumer could break: removed fields, renamed fields, or changed semantics of an existing field. Version 2 adds the fingerprint oracle's states and diagnoses, per-run phases, suppressions and per-operator error counts. Version 2.1.0 adds, additively: per-mutant provenance (selection, execution, cache key, baseline status), the selected/omitted/cached/fresh population split, the selection record, sampling metadata, and the gate table outcomes. Version 2.2.0 adds, additively: the suggestion outcome table with its closed status vocabulary and two-leg verification evidence, the record of what an --apply invocation wrote, and the sensitivity flag each delta change carries. The suggestion outcome table’s presence rules are normative and encoded: every skipped status carries no patch and a status_reason; refuted requires status_reason and verification; verified requires verified_digest and verification. Version 2.3.0 adds, additively: the characterisation block — scenarios, pins, TODOs, scaffolds, curate findings, generated files, the write record and the until-dry convergence evidence. Its status vocabularies are closed, and its presence rules are normative and encoded: every skipped pin carries no expression and a reason, every open TODO carries no executable content, and a sensitive value reaches no field at all. Extending one of these closed enumerations is a minor schema version with the consumer contract documented, not a silently additive change.",
  "type": "object",
  "required": [
    "schema_version",
    "command",
    "module",
    "terraform_version",
    "test_directory",
    "baseline",
    "mutants",
    "findings",
    "metrics",
    "operator_errors",
    "suppressions",
    "warnings",
    "errors",
    "population",
    "selection"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.3.0"
    },
    "command": {
      "type": "string",
      "enum": [
        "run",
        "preview",
        "suggest",
        "characterise",
        "curate",
        "todos"
      ]
    },
    "module": {
      "type": "string",
      "description": "Absolute directory of the module under test."
    },
    "closure_root": {
      "type": "string",
      "description": "Absolute directory containing every local module; mutant file paths are relative to it."
    },
    "terraform_version": {
      "type": "string"
    },
    "test_directory": {
      "type": "string",
      "description": "Test directory, relative to the module."
    },
    "baseline": {
      "type": "object",
      "required": [
        "runs",
        "assertions",
        "duration_ms",
        "fingerprint",
        "volatile_components"
      ],
      "properties": {
        "runs": {
          "type": "integer"
        },
        "assertions": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "integer"
        },
        "fingerprint": {
          "type": "string",
          "description": "Composed masked fingerprint of the unmutated suite."
        },
        "volatile_components": {
          "type": "array",
          "description": "Canonical payload paths the volatile mask removes.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mutants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mutant"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "mutation_score",
        "assertion_score",
        "reachability",
        "incomplete",
        "counts",
        "diagnoses",
        "scored"
      ],
      "properties": {
        "mutation_score": {
          "type": "number"
        },
        "assertion_score": {
          "type": "number"
        },
        "reachability": {
          "type": "number"
        },
        "incomplete": {
          "type": "boolean",
          "description": "True when a timeout made the score untrustworthy."
        },
        "counts": {
          "type": "object",
          "description": "Number of mutants in each state.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "diagnoses": {
          "type": "object",
          "description": "Number of survivors carrying each diagnosis.",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "scored": {
          "type": "integer",
          "description": "Killed + KilledByError + Survived + StructurallyUnassertable + NoCoverage + Timeout."
        }
      }
    },
    "operator_errors": {
      "type": "array",
      "description": "Per-operator generation quality, so that the selective-validation question can be answered from data.",
      "items": {
        "type": "object",
        "required": [
          "operator",
          "generated",
          "invalid",
          "killed_by_error",
          "error_rate"
        ],
        "properties": {
          "operator": {
            "$ref": "#/$defs/operator"
          },
          "generated": {
            "type": "integer"
          },
          "invalid": {
            "type": "integer"
          },
          "killed_by_error": {
            "type": "integer"
          },
          "error_rate": {
            "type": "number"
          }
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suppression"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "description": "Mutants that produced no trustworthy verdict. Never a survivor.",
      "items": {
        "type": "object",
        "required": [
          "mutant_id",
          "site",
          "message"
        ],
        "properties": {
          "mutant_id": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "population": {
      "$ref": "#/$defs/population"
    },
    "selection": {
      "$ref": "#/$defs/selection"
    },
    "sampling": {
      "$ref": "#/$defs/sampling"
    },
    "gates": {
      "$ref": "#/$defs/gates"
    },
    "suggestions": {
      "type": "array",
      "description": "The generated assertion outcome table (2.2.0). Present only for the suggest command.",
      "items": {
        "$ref": "#/$defs/suggestion"
      }
    },
    "apply": {
      "$ref": "#/$defs/applied_suggestions"
    },
    "characterisation": {
      "$ref": "#/$defs/characterisation",
      "description": "The scaffold, pin, TODO and curate block (2.3.0). Present only for the characterise, todos and curate commands."
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "required": [
        "line",
        "column"
      ],
      "properties": {
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        }
      }
    },
    "range": {
      "type": "object",
      "required": [
        "file",
        "start",
        "end"
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "Path relative to the local-module closure root."
        },
        "start": {
          "$ref": "#/$defs/position"
        },
        "end": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "operator": {
      "type": "string",
      "enum": [
        "ARITH-SWAP",
        "BOOL-AND-OR",
        "BOOL-LITERAL-FLIP",
        "BOOL-NEGATE-INSERT",
        "BOOL-NEGATE-REMOVE",
        "BOOL-OR-AND",
        "CHECK-NEGATE",
        "CHECK-REMOVE",
        "CMP-BOUNDARY",
        "CMP-EQ-NE",
        "CMP-INVERT",
        "COLL-DROP-ENTRY",
        "COLL-DROP-FIRST",
        "COLL-DROP-LAST",
        "COLL-EMPTY",
        "COLL-REVERSE",
        "COND-FALSE",
        "COND-NEGATE",
        "COND-SWAP",
        "COND-TRUE",
        "COUNT-OFF-BY-ONE",
        "COUNT-ONE",
        "COUNT-ZERO",
        "DEPENDS-DROP",
        "DYNAMIC-ZERO",
        "EXT-ATTR-DELETE",
        "EXT-BODY-BLANK",
        "EXT-LOCAL-NULL",
        "EXT-MODULE-INPUT-DELETE",
        "EXT-OUTPUT-NULL",
        "EXT-RESOURCE-DELETE",
        "FN-ARG-REORDER",
        "FN-CAN-TRUE",
        "FN-DROP-DEFAULT",
        "FN-DROP-EXPANSION",
        "FN-DROP-WRAPPER",
        "FN-JOIN-SEP",
        "FN-SWAP",
        "FN-TRY-FIRST",
        "FOR-DROP-GROUPING",
        "FOR-DROP-IF",
        "FOR-NEGATE-IF",
        "FOR-SWAP-KV",
        "FOREACH-EMPTY",
        "FOREACH-TO-COUNT",
        "HEREDOC-INDENT-FLIP",
        "IDX-SHIFT",
        "NULL-INJECT",
        "NUM-NEGATE",
        "NUM-OFF-BY-ONE",
        "NUM-ZERO",
        "OUT-SENSITIVE-FLIP",
        "PRE-POST-NEGATE",
        "PRE-POST-REMOVE",
        "PROVIDER-ALIAS-SWAP",
        "SPLAT-FIRST",
        "STR-CASE",
        "STR-EMPTY",
        "TPL-DROP-INTERP",
        "TPL-IF-COLLAPSE",
        "TPL-STRIP-FLIP",
        "VAR-DEFAULT-CHANGE",
        "VAR-DEFAULT-NULL",
        "VAR-DEFAULT-REMOVE",
        "VAR-NULLABLE-FLIP",
        "VAR-OPTIONAL-DEFAULT-DROP",
        "VAR-SENSITIVE-FLIP",
        "VAR-VALIDATION-NEGATE",
        "VAR-VALIDATION-REMOVE",
        "VAR-VALIDATION-WEAKEN"
      ]
    },
    "diagnosis": {
      "type": "string",
      "description": "Set only for Survived. Exactly one, assigned by the normative precedence: indeterminate-unknown-values, indeterminate-volatility, weak-assertion, no-assertion, unasserted. The mock-masked value is deprecated: withdrawn in M3 (#50), retained so 2.0 documents stay valid, never emitted again.",
      "enum": [
        "indeterminate-unknown-values",
        "indeterminate-volatility",
        "mock-masked",
        "weak-assertion",
        "no-assertion",
        "unasserted"
      ]
    },
    "change": {
      "type": "object",
      "required": [
        "run",
        "path",
        "baseline",
        "mutant"
      ],
      "properties": {
        "run": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Canonical payload path."
        },
        "address": {
          "type": "string",
          "description": "Terraform address the path names, when it names one."
        },
        "baseline": {
          "type": "string",
          "description": "Canonical rendering; empty means the path was absent."
        },
        "mutant": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean",
          "description": "Terraform marks this value, or a container of it, sensitive (2.2.0). Retention is not permission to render: it is what the suggestion engine refuses to inline the value from."
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "message",
        "fix",
        "evidence"
      ],
      "properties": {
        "diagnosis": {
          "$ref": "#/$defs/diagnosis"
        },
        "message": {
          "type": "string"
        },
        "fix": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "delta": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/change"
              }
            },
            "unknown_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "volatile_components": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unstable_attributes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assertion": {
              "type": "string"
            },
            "closure_verdict": {
              "type": "string"
            },
            "defeated_by": {
              "type": "string"
            },
            "mock_resource": {
              "type": "string",
              "description": "Deprecated: carried only by the withdrawn mock-masked diagnosis (M3, #50); retained so 2.0 documents stay valid, never emitted again."
            }
          }
        }
      }
    },
    "suppression": {
      "type": "object",
      "required": [
        "kind",
        "accepted"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "comment",
            "config-operator",
            "config-path",
            "config-resource"
          ]
        },
        "operators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "accepted": {
          "type": "boolean",
          "description": "A directive without a reason does not suppress: the finding stands and the directive is reported here as rejected."
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "mutants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejection": {
          "type": "string"
        }
      }
    },
    "mutant": {
      "type": "object",
      "required": [
        "id",
        "operator",
        "tier",
        "module",
        "site",
        "range",
        "diff",
        "state",
        "runs",
        "executed_runs",
        "validated"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Hash of operator, closure-relative path, site address, replaced content and replacement. Stable under line moves and unrelated edits; broken by renaming the file."
        },
        "operator": {
          "$ref": "#/$defs/operator"
        },
        "tier": {
          "type": "string",
          "enum": [
            "smoke",
            "standard",
            "deep"
          ]
        },
        "module": {
          "type": "string",
          "description": "Module directory relative to the closure root."
        },
        "site": {
          "type": "string",
          "description": "Semantic address of the mutation site."
        },
        "resource": {
          "type": "string",
          "description": "Managed resource address the site belongs to, when it has one."
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "diff": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "Invalid",
            "Killed",
            "KilledByError",
            "Timeout",
            "Survived",
            "StructurallyUnassertable",
            "Unobservable",
            "NoCoverage",
            "Ignored",
            "Pending"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "runs": {
          "type": "array",
          "description": "Per-run outcomes, recorded orthogonally to the aggregate state. Phase two appears only for phase-one survivors.",
          "items": {
            "$ref": "#/$defs/run_outcome"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "severity",
              "summary",
              "detail"
            ],
            "properties": {
              "severity": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "range": {
                "$ref": "#/$defs/range"
              },
              "test_file": {
                "type": "string"
              },
              "test_run": {
                "type": "string"
              }
            }
          }
        },
        "executed_runs": {
          "type": "integer"
        },
        "validated": {
          "type": "boolean",
          "description": "Whether lazy validation ran, which happens only after a run-level error."
        },
        "suppression": {
          "$ref": "#/$defs/suppression"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "address",
        "module",
        "range",
        "message",
        "mutants"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "pseudo-tested"
          ]
        },
        "address": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "message": {
          "type": "string"
        },
        "mutants": {
          "type": "array",
          "description": "Identifiers of the mutants supporting the finding.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Why the mutant is in this run and how its verdict was obtained.",
      "required": [
        "selection",
        "execution"
      ],
      "properties": {
        "selection": {
          "enum": [
            "full",
            "since",
            "sample"
          ]
        },
        "reason": {
          "type": "string"
        },
        "execution": {
          "enum": [
            "fresh",
            "cached"
          ]
        },
        "cache_key": {
          "type": "string"
        },
        "baseline_status": {
          "enum": [
            "new",
            "accepted",
            "unobserved"
          ]
        }
      }
    },
    "population": {
      "type": "object",
      "description": "The population split: what this run selected, left out, replayed and executed.",
      "required": [
        "selected",
        "omitted",
        "cached",
        "fresh"
      ],
      "properties": {
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "integer",
          "minimum": 0
        },
        "fresh": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selection": {
      "type": "object",
      "description": "How the population was chosen.",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "full",
            "since"
          ]
        },
        "ref": {
          "type": "string"
        },
        "forced_full": {
          "type": "string",
          "description": "Why a --since run fell back to the full population."
        }
      }
    },
    "sampling": {
      "type": "object",
      "description": "Sampling metadata. A sampled run is never authoritative.",
      "required": [
        "rate_percent",
        "seed",
        "authoritative"
      ],
      "properties": {
        "rate_percent": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "authoritative": {
          "const": false
        },
        "gate_opt_in": {
          "type": "boolean",
          "description": "True where --allow-sampled-gate let this sample satisfy a gate."
        }
      }
    },
    "gate_outcome": {
      "type": "object",
      "description": "One row outcome of the normative gate table.",
      "required": [
        "evaluated"
      ],
      "properties": {
        "evaluated": {
          "type": "boolean"
        },
        "scope": {
          "enum": [
            "full",
            "selected"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "refused": {
          "type": "string"
        }
      }
    },
    "baseline_gate": {
      "type": "object",
      "description": "What the baseline file contributed to the run.",
      "required": [
        "path",
        "accepted",
        "matched",
        "new",
        "staleness_reported"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "new": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unobserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "staleness_reported": {
          "type": "boolean"
        },
        "write": {
          "enum": [
            "permitted",
            "refused",
            "written"
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "description": "The gate table's outcomes for this run.",
      "required": [
        "min_score",
        "fail_on_new"
      ],
      "properties": {
        "min_score": {
          "$ref": "#/$defs/gate_outcome"
        },
        "fail_on_new": {
          "$ref": "#/$defs/gate_outcome"
        },
        "baseline": {
          "$ref": "#/$defs/baseline_gate"
        }
      }
    },
    "suggestion_status": {
      "type": "string",
      "description": "The complete suggestion status vocabulary (2.2.0).",
      "enum": [
        "candidate",
        "verified",
        "refuted",
        "skipped-sensitive",
        "skipped-unaddressable",
        "skipped-unrenderable",
        "skipped-unsupported-target"
      ]
    },
    "verification_leg": {
      "type": "object",
      "required": [
        "passed",
        "runs",
        "detail"
      ],
      "properties": {
        "passed": {
          "type": "boolean",
          "description": "Whether the leg met its requirement: green for the baseline leg, failing for the isolated mutant leg."
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run_outcome"
          }
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "baseline",
        "mutant"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/verification_leg",
          "description": "The full suite, run once with the target file’s candidate batch applied. Green required."
        },
        "mutant": {
          "$ref": "#/$defs/verification_leg",
          "description": "This suggestion alone against its re-materialised mutant. Failure required."
        }
      }
    },
    "suggestion": {
      "type": "object",
      "required": [
        "id",
        "mutant_id",
        "target_file",
        "target_run",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Content hash over the mutant identifier, the target run and the expression. Stable across runs."
        },
        "mutant_id": {
          "type": "string"
        },
        "also_kills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Further survivors the same assertion kills: one expression that kills five mutants is one suggestion, one write, and one isolated verification per listed mutant."
        },
        "target_file": {
          "type": "string",
          "description": "Test file, relative to the module directory."
        },
        "target_run": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/suggestion_status"
        },
        "expression": {
          "type": "string",
          "description": "The generated assert condition. Absent for every status whose reason forbids one."
        },
        "patch": {
          "type": "string",
          "description": "Unified diff adding the assertion. Present only for candidate, verified and refuted: every skipped status carries no patch."
        },
        "verified_digest": {
          "type": "string",
          "description": "SHA-256 of the target file as verified, which binds an apply to what was proven."
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "status_reason": {
          "type": "string",
          "description": "Required for every refuted and every skipped status."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "skipped-sensitive",
                  "skipped-unaddressable",
                  "skipped-unrenderable",
                  "skipped-unsupported-target"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "patch"
              ]
            },
            "required": [
              "status_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "refuted"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "status_reason",
              "verification"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "verified_digest",
              "verification"
            ]
          }
        }
      ]
    },
    "applied_suggestions": {
      "type": "object",
      "required": [
        "requested",
        "written"
      ],
      "properties": {
        "requested": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Target files written, in write order."
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Target files a failure left unwritten."
        },
        "aborted": {
          "type": "string",
          "description": "Why the protocol refused or stopped. A preflight refusal writes nothing at all."
        },
        "partial": {
          "type": "boolean",
          "description": "Some files were written and others were not."
        }
      }
    },
    "run_outcome": {
      "type": "object",
      "required": [
        "file",
        "run",
        "phase",
        "status"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "run": {
          "type": "string"
        },
        "phase": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "error",
            "skip"
          ]
        }
      }
    },
    "pin_status": {
      "type": "string",
      "enum": [
        "pinned",
        "skipped-sensitive",
        "skipped-unrenderable",
        "skipped-volatile",
        "skipped-mock-invented"
      ],
      "description": "Closed vocabulary. Only `pinned` carries an expression."
    },
    "todo_status": {
      "type": "string",
      "enum": [
        "open",
        "answered",
        "promoted",
        "rejected"
      ],
      "description": "Closed vocabulary. Promotion is the only route from a TODO into executable test content."
    },
    "scaffold_status": {
      "type": "string",
      "enum": [
        "scaffolded",
        "promoted"
      ],
      "description": "Closed vocabulary. Scaffolded material is non-executable until it has been verified and promoted."
    },
    "curate_kind": {
      "type": "string",
      "enum": [
        "empty-kill-set",
        "subsumed",
        "cross-scenario-redundant"
      ],
      "description": "Closed vocabulary of redundancy findings."
    },
    "assertion_provenance": {
      "type": "string",
      "enum": [
        "generated-unmodified",
        "generated-edited",
        "pre-existing"
      ],
      "description": "Decided mechanically against the generated-assertion registry, never guessed."
    },
    "input_provenance": {
      "type": "string",
      "enum": [
        "default",
        "mined",
        "typed",
        "answered"
      ],
      "description": "Where a scenario's variable assignment came from, in the synthesis preference order."
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "name",
        "state_key",
        "file",
        "inputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Content hash over the module, the input assignment set and the state key."
        },
        "name": {
          "type": "string"
        },
        "state_key": {
          "type": "string",
          "description": "Isolates the scenario's Terraform state from every other generated scenario, so its pins describe creates rather than updates."
        },
        "file": {
          "type": "string",
          "description": "The generated test file, relative to the module directory."
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "expression",
              "provenance"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "expression": {
                "type": "string",
                "description": "The assignment as written into the run block. A sensitive or ephemeral variable carries the withheld marker instead of a value."
              },
              "provenance": {
                "$ref": "#/$defs/input_provenance"
              }
            }
          }
        }
      }
    },
    "pin": {
      "type": "object",
      "required": [
        "id",
        "scenario",
        "address",
        "status",
        "rung"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Content hash over the scenario, the address and the expression. The address is the dedup key: one pin per address per run."
        },
        "scenario": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "expression": {
          "type": "string",
          "description": "The generated assert condition. Absent for every skipped status."
        },
        "status": {
          "$ref": "#/$defs/pin_status"
        },
        "reason": {
          "type": "string",
          "description": "Required for every skipped status."
        },
        "rung": {
          "type": "string",
          "enum": [
            "outputs",
            "counts",
            "configured"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "skipped-sensitive",
                  "skipped-unrenderable",
                  "skipped-volatile",
                  "skipped-mock-invented"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "expression"
              ]
            },
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pinned"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "expression"
            ]
          }
        }
      ]
    },
    "todo": {
      "type": "object",
      "required": [
        "id",
        "variable",
        "status",
        "range"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Content hash over the variable and the constraint range, so the identifier survives a resume."
        },
        "variable": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/todo_status"
        },
        "constraint": {
          "type": "string",
          "description": "The constraint expression verbatim."
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "diagnostic": {
          "type": "string",
          "description": "The last attempt's failure, redacted."
        },
        "attempted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The values already tried, redacted."
        },
        "artefact": {
          "type": "string",
          "description": "The non-executable file the TODO lives in, relative to the module directory."
        }
      }
    },
    "scaffold": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "address",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Content hash over the construct address."
        },
        "kind": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/scaffold_status"
        },
        "artefact": {
          "type": "string"
        }
      }
    },
    "curate_finding": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "members",
        "provenance",
        "mutants",
        "population_authoritative",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Content hash over the kind and the member set."
        },
        "kind": {
          "$ref": "#/$defs/curate_kind"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion_provenance"
          },
          "description": "One entry per member, in the same order."
        },
        "mutants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "population_authoritative": {
          "type": "boolean",
          "const": true,
          "description": "Always true: curate refuses a partial population at configuration time, and the flag is published so no consumer has to know the rule to apply it."
        },
        "message": {
          "type": "string"
        }
      }
    },
    "generated_file": {
      "type": "object",
      "required": [
        "path",
        "content",
        "digest",
        "executable",
        "written"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative to the module directory."
        },
        "content": {
          "type": "string",
          "description": "The file's bytes as a report may publish them. Content travels in the report whenever a JSON reporter owns standard output. For a scenario with a sensitive input this is the *redacted* rendering: the assignment carries the withheld marker, because a secret may reach no report field."
        },
        "digest": {
          "type": "string",
          "description": "The digest of the bytes in `content`, and therefore of the *redacted* rendering wherever a scenario assigns a sensitive input. It is deliberately not the digest of the file on disk: `content` is a deterministic template, so publishing a digest of the executable bytes beside it would let a reader recover a withheld value by substituting candidates and comparing hashes. The digest of the written bytes is recorded in the module-local provenance registry (`.tf-mut-generated.json`), which is where the write protocol commits against it."
        },
        "executable": {
          "type": "boolean",
          "description": "False for the non-executable artefact class: the files `terraform test` never reads."
        },
        "written": {
          "type": "boolean"
        }
      }
    },
    "characterise_write": {
      "type": "object",
      "required": [
        "requested",
        "input_digest"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "input_digest": {
          "type": "string",
          "description": "The digest of the input closure that made the scaffold green, re-checked immediately before each rename."
        },
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refused": {
          "type": "string"
        },
        "partial": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The files written before an abort, where the commit could not complete as a whole."
        }
      }
    },
    "convergence": {
      "type": "object",
      "required": [
        "rounds",
        "new_pins_per_round",
        "stop_reason"
      ],
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 0
        },
        "new_pins_per_round": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "stop_reason": {
          "type": "string",
          "enum": [
            "dry",
            "bounded",
            "refused"
          ]
        }
      }
    },
    "characterisation": {
      "type": "object",
      "required": [
        "rung",
        "complete",
        "scenarios",
        "pins",
        "files",
        "staged"
      ],
      "properties": {
        "rung": {
          "type": "string",
          "enum": [
            "outputs",
            "counts",
            "configured"
          ]
        },
        "rung_requested": {
          "type": "string",
          "enum": [
            "outputs",
            "counts",
            "configured"
          ],
          "description": "Present only when the zero-output contract escalated away from it."
        },
        "escalated": {
          "type": "boolean"
        },
        "escalation_reason": {
          "type": "string"
        },
        "complete": {
          "type": "boolean",
          "description": "False whenever the selected rung produced no pins: a characterisation that pinned nothing may never report complete."
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          }
        },
        "pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "todos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/todo"
          }
        },
        "scaffolds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scaffold"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generated_file"
          }
        },
        "curate_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/curate_finding"
          }
        },
        "write": {
          "$ref": "#/$defs/characterise_write"
        },
        "convergence": {
          "$ref": "#/$defs/convergence"
        },
        "staged": {
          "type": "boolean",
          "description": "The suite existed only as an overlay: no byte of the source tree was changed."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "escalated": {
                "const": true
              }
            },
            "required": [
              "escalated"
            ]
          },
          "then": {
            "required": [
              "rung_requested",
              "escalation_reason"
            ]
          }
        }
      ]
    }
  }
}
